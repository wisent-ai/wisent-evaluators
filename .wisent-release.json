{
  "schema_version": 1,
  "product": "wisent-evaluators",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>\\d+\\.\\d+\\.\\d+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [{"name": "fmt", "argv": ["cargo", "fmt", "--all", "--", "--check"]}],
      "build": {
        "argv": ["stado", "product", "cargo", "stage", "--bin", "wisent-evaluators"]
      },
      "stage": {
        "wisent-evaluators": "bin/wisent-evaluators"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [{"name": "fmt", "argv": ["cargo", "fmt", "--all", "--", "--check"]}],
      "build": {
        "argv": ["stado", "product", "cargo", "stage", "--bin", "wisent-evaluators"]
      },
      "stage": {
        "wisent-evaluators": "bin/wisent-evaluators"
      }
    }
  },
  "promotion": {
    "channels": ["stable"],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": []
}
